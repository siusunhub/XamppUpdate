<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme Palette (Light Theme Only) -->
    <Color x:Key="WindowBgColor">#F8FAFC</Color>
    <Color x:Key="SurfaceBgColor">#FFFFFF</Color>
    <Color x:Key="SurfaceSubtleBgColor">#F1F5F9</Color>
    <Color x:Key="SurfaceHoverBgColor">#F8FAFC</Color>
    
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="BorderSubtleColor">#EEF2F6</Color>
    <Color x:Key="BorderFocusColor">#0284C7</Color>
    
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#475569</Color>
    <Color x:Key="TextMutedColor">#94A3B8</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>

    <!-- Brand / Accent Colors -->
    <Color x:Key="PrimaryAccentColor">#0284C7</Color>
    <Color x:Key="PrimaryAccentHoverColor">#0369A1</Color>
    <Color x:Key="PrimaryAccentPressedColor">#075985</Color>
    <Color x:Key="PrimaryAccentSubtleColor">#E0F2FE</Color>

    <!-- Status Colors -->
    <Color x:Key="SuccessBgColor">#DCFCE7</Color>
    <Color x:Key="SuccessBorderColor">#86EFAC</Color>
    <Color x:Key="SuccessFgColor">#15803D</Color>

    <Color x:Key="WarningBgColor">#FEF3C7</Color>
    <Color x:Key="WarningBorderColor">#FDE68A</Color>
    <Color x:Key="WarningFgColor">#B45309</Color>

    <Color x:Key="DangerBgColor">#FEE2E2</Color>
    <Color x:Key="DangerBorderColor">#FECACA</Color>
    <Color x:Key="DangerFgColor">#B91C1C</Color>

    <Color x:Key="NeutralBgColor">#F1F5F9</Color>
    <Color x:Key="NeutralBorderColor">#CBD5E1</Color>
    <Color x:Key="NeutralFgColor">#475569</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="SurfaceBgBrush" Color="{StaticResource SurfaceBgColor}" />
    <SolidColorBrush x:Key="SurfaceSubtleBgBrush" Color="{StaticResource SurfaceSubtleBgColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBgBrush" Color="{StaticResource SurfaceHoverBgColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />

    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="{StaticResource PrimaryAccentHoverColor}" />
    <SolidColorBrush x:Key="PrimaryAccentPressedBrush" Color="{StaticResource PrimaryAccentPressedColor}" />
    <SolidColorBrush x:Key="PrimaryAccentSubtleBrush" Color="{StaticResource PrimaryAccentSubtleColor}" />

    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="{StaticResource SuccessBorderColor}" />
    <SolidColorBrush x:Key="SuccessFgBrush" Color="{StaticResource SuccessFgColor}" />

    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{StaticResource WarningBorderColor}" />
    <SolidColorBrush x:Key="WarningFgBrush" Color="{StaticResource WarningFgColor}" />

    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource DangerBorderColor}" />
    <SolidColorBrush x:Key="DangerFgBrush" Color="{StaticResource DangerFgColor}" />

    <SolidColorBrush x:Key="NeutralBgBrush" Color="{StaticResource NeutralBgColor}" />
    <SolidColorBrush x:Key="NeutralBorderBrush" Color="{StaticResource NeutralBorderColor}" />
    <SolidColorBrush x:Key="NeutralFgBrush" Color="{StaticResource NeutralFgColor}" />

</ResourceDictionary>
