<Window x:Class="XamppUpdate.Views.ClearTempProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:XamppUpdate.Converters"
        mc:Ignorable="d"
        Title="Cleaning Temporary Files"
        Height="275" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/app.ico"
        Background="{StaticResource WindowBgBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Buttons.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Progress Card -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border DockPanel.Dock="Left"
                    Background="{StaticResource PrimaryAccentSubtleBrush}"
                    CornerRadius="20"
                    Width="40" Height="40"
                    Margin="0,0,12,0">
                <TextBlock Text="🧹" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Cleaning Temporary Files" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Removing temporary update files in the background..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Progress Card -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding StatusText}"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding ProgressPercentText}"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="{StaticResource PrimaryAccentBrush}"
                               HorizontalAlignment="Right" />
                </DockPanel>

                <!-- Modern Progress Bar -->
                <ProgressBar Style="{StaticResource ModernProgressBarStyle}"
                             Height="8"
                             Minimum="0"
                             Maximum="{Binding TotalItems}"
                             Value="{Binding CurrentItem}"
                             IsIndeterminate="{Binding IsIndeterminate}" />

                <Grid Margin="0,8,0,0">
                    <TextBlock Text="{Binding CurrentItemName}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Left"
                               MaxWidth="310" />
                    <TextBlock Text="{Binding ProgressCountText}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Footer Actions -->
        <DockPanel Grid.Row="2">
            <TextBlock Text="{Binding DetailedResultText}"
                       FontSize="11.5"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="360" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="✕ Cancel"
                        Click="BtnCancel_Click"
                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisConverter}}"
                        Padding="14,6" />
                <Button x:Name="BtnClose"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="✓ Done"
                        Click="BtnClose_Click"
                        Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisConverter}}"
                        Padding="18,6" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
