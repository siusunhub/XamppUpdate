<Window x:Class="XamppUpdate.Views.ComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:XamppUpdate.Views.Controls"
        xmlns:conv="clr-namespace:XamppUpdate.Converters"
        mc:Ignorable="d"
        Title="Composer Dependency Manager &amp; Update Tools"
        Height="660" Width="1080"
        MinHeight="540" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/app.ico"
        Background="{StaticResource WindowBgBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True" />
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header & Config Bar -->
            <RowDefinition Height="Auto" />
            <!-- Action Commands Card (3 Buttons) -->
            <RowDefinition Height="Auto" />
            <!-- Live Execution Log Terminal -->
            <RowDefinition Height="*" />
            <!-- Footer Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📦" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Composer Dependency Manager" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Manage Composer runtime, package updates, and WWW deployment" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Version Info -->
                <Border Grid.Column="1" Background="{StaticResource SurfaceSubtleBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Installed Composer: " FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ComposerVersion}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 4 Primary Action Command Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Action 1: Self Update -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="1. Self-Update" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Upgrades the Composer executable itself to the latest official release."
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    </StackPanel>

                    <Button Grid.Row="2" Style="{StaticResource PrimaryButtonStyle}"
                            Content="🔄 Update Composer"
                            Command="{Binding RunSelfUpdateCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            Padding="8,8" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </Grid>
            </Border>

            <!-- Action 2: Check All Packages & Versions -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="3,0,3,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="2. Check All Packages" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Runs 'composer outdated --all' in Download Target to inspect all installed and latest versions."
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    </StackPanel>

                    <Button Grid.Row="2" Style="{StaticResource PrimaryButtonStyle}"
                            Content="🔍 Check All Packages"
                            Command="{Binding RunCheckOutdatedCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            Padding="8,8" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </Grid>
            </Border>

            <!-- Action 3: Download & Update Packages -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="3,0,3,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="3. Download / Update" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Runs 'composer update' in Download Target Directory to fetch and update libraries."
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8" />

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="📝 Edit composer.json"
                                Command="{Binding OpenComposerJsonCommand}"
                                Padding="8,4" FontSize="11" HorizontalAlignment="Left" Margin="0,0,0,8"
                                ToolTip="Opens composer.json in default text editor to modify required versions" />

                        <!-- Update With All Dependencies Option -->
                        <CheckBox IsChecked="{Binding IsWithAllDependencies}"
                                  Content="📦 Update with all dependencies (-W)"
                                  FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"
                                  ToolTip="Executes 'composer update --with-all-dependencies' to update all packages and sub-dependencies" />
                    </StackPanel>

                    <Button Grid.Row="2" Style="{StaticResource PrimaryButtonStyle}"
                            Content="📦 Update Packages"
                            Command="{Binding RunPackageUpdateCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            Padding="8,8" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </Grid>
            </Border>

            <!-- Action 4: Backup & Deploy to WWW -->
            <Border Grid.Column="3" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Grid>
                            <TextBlock Text="4. Backup &amp; Deploy" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Border HorizontalAlignment="Right" Background="#DCFCE7" CornerRadius="4" Padding="5,1">
                                <TextBlock Text="📦 Auto-Backup" FontSize="9.5" FontWeight="Bold" Foreground="#15803D" />
                            </Border>
                        </Grid>
                        <TextBlock Text="Backs up WWW vendor/ and deploys downloaded packages to WWW Target."
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8" />

                        <!-- Test Mode Dry-Run Option -->
                        <CheckBox IsChecked="{Binding IsTestMode}"
                                  Content="🧪 Dry-Run (Test Mode)"
                                  FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"
                                  ToolTip="Performs real backup of WWW vendor/ and simulates file copy without modifying live WWW files" />
                    </StackPanel>

                    <Button Grid.Row="2" Style="{StaticResource PrimaryButtonStyle}"
                            Content="🚀 Deploy to WWW"
                            Command="{Binding RunDeployToWwwCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            Padding="8,8" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- Live Execution Log Terminal -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
            <DockPanel>
                <!-- Terminal Header Bar -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="EXECUTION LOG FEED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                        <ProgressBar Width="120" Height="4" IsIndeterminate="True"
                                     Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisConverter}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="📋 Copy Log" Command="{Binding CopyLogsCommand}" Padding="10,4" FontSize="11.5" Margin="0,0,6,0" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="🗑️ Clear" Command="{Binding ClearLogsCommand}" Padding="10,4" FontSize="11.5" />
                    </StackPanel>
                </Grid>

                <!-- Log Console ListBox -->
                <Border Background="{StaticResource SurfaceSubtleBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                    <ListBox ItemsSource="{Binding ExecutionLogs}"
                             controls:AutoScrollBehavior.AutoScroll="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             FontFamily="Consolas, Cascadia Code, Courier New"
                             FontSize="12" />
                </Border>
            </DockPanel>
        </Border>

        <!-- Footer Status Bar -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="✕ Cancel"
                        Command="{Binding CancelOperationCommand}"
                        Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisConverter}}"
                        Padding="14,6" FontSize="12" Margin="0,0,8,0" />

                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="Close"
                        Command="{Binding CloseCommand}"
                        Padding="18,6" FontSize="12" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
