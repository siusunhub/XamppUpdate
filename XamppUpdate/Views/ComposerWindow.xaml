<Window x:Class="XamppUpdate.Views.ComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:XamppUpdate.Converters"
        mc:Ignorable="d"
        Title="Composer Dependency Manager &amp; Update Tools"
        Height="720" Width="1000"
        MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/app.ico"
        Background="{StaticResource WindowBgBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True" />
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header & Config Bar -->
            <RowDefinition Height="Auto" />
            <!-- Action Commands Card (3 Buttons) -->
            <RowDefinition Height="Auto" />
            <!-- Live Execution Log Terminal -->
            <RowDefinition Height="*" />
            <!-- Footer Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header & Config Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title & Version Info -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📦" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Composer Dependency Manager" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Manage Composer runtime and update downloaded vendor packages" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{StaticResource SurfaceSubtleBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Installed Composer: " FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ComposerVersion}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Path Configuration Row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Executable Path -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Composer Executable (composer.bat / composer.phar):" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ComposerExecutablePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" FontSize="12" Padding="8,6" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Browse..." Command="{Binding BrowseComposerExecutableCommand}" Padding="10,6" Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <!-- Project Working Directory -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Project Working Directory (folder containing composer.json):" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" FontSize="12" Padding="8,6" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Browse..." Command="{Binding BrowseWorkingDirectoryCommand}" Padding="10,6" Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 3 Primary Action Command Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <!-- Action 1: Self Update -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="1. Composer Self-Update" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Upgrades the Composer executable itself to the latest official release."
                                   FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    </StackPanel>

                    <Button Grid.Row="2" Style="{StaticResource PrimaryButtonStyle}"
                            Content="🔄 Update Composer Itself"
                            Command="{Binding RunSelfUpdateCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            Padding="12,8" FontSize="12.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </Grid>
            </Border>

            <!-- Action 2: Check Outdated Components -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="2. Check New Components" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Scans installed packages against Packagist and lists available newer versions."
                                   FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    </StackPanel>

                    <Button Grid.Row="2" Style="{StaticResource PrimaryButtonStyle}"
                            Content="🔍 Check Outdated Components"
                            Command="{Binding RunCheckOutdatedCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            Padding="12,8" FontSize="12.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </Grid>
            </Border>

            <!-- Action 3: Update Downloaded Library with Backup & Test Mode -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Grid>
                            <TextBlock Text="3. Update Libraries" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Border HorizontalAlignment="Right" Background="#DCFCE7" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="📦 Auto-Backups vendor/" FontSize="10" FontWeight="Bold" Foreground="#15803D" />
                            </Border>
                        </Grid>
                        <TextBlock Text="Updates project packages and dependencies in the selected working directory."
                                   FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8" />

                        <!-- Test Mode Dry-Run Option -->
                        <CheckBox IsChecked="{Binding IsTestMode}"
                                  Content="🧪 Dry-Run Simulation (Test Mode)"
                                  FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"
                                  ToolTip="Simulates package update with '--dry-run' without touching files or composer.lock" />
                    </StackPanel>

                    <Button Grid.Row="2" Style="{StaticResource PrimaryButtonStyle}"
                            Content="📦 Update Project Packages"
                            Command="{Binding RunPackageUpdateCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            Padding="12,8" FontSize="12.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- Live Execution Log Terminal -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
            <DockPanel>
                <!-- Terminal Header Bar -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="EXECUTION LOG FEED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                        <ProgressBar Width="120" Height="4" IsIndeterminate="True"
                                     Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisConverter}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="📋 Copy Log" Command="{Binding CopyLogsCommand}" Padding="10,4" FontSize="11.5" Margin="0,0,6,0" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Clear" Command="{Binding ClearLogsCommand}" Padding="10,4" FontSize="11.5" />
                    </StackPanel>
                </Grid>

                <!-- Log Console ListBox -->
                <Border Background="{StaticResource SurfaceSubtleBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                    <ListBox ItemsSource="{Binding ExecutionLogs}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             FontFamily="Consolas, Cascadia Code, Courier New"
                             FontSize="12" />
                </Border>
            </DockPanel>
        </Border>

        <!-- Footer Status Bar -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                    Content="Cancel"
                    Command="{Binding CancelOperationCommand}"
                    Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisConverter}}"
                    Padding="14,6" FontSize="12" />
        </Grid>
    </Grid>
</Window>
