<Window x:Class="XamppUpdate.Views.UatUpgradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:XamppUpdate.Converters"
        Title="Real Test Upgrade (UAT copy)"
        Height="640" Width="900" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBgBrush}">

    <Window.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Rehearse the upgrade on a full copy, in parallel with production"
                   FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

        <!-- Options -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,12">
            <Grid IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Target folder:" VerticalAlignment="Center" Margin="0,0,8,6" />
                <TextBox Style="{StaticResource ModernTextBoxStyle}" Grid.Row="0" Grid.Column="1" Text="{Binding TargetRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,6" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Port:" VerticalAlignment="Center" Margin="0,0,8,6" />
                <TextBox Style="{StaticResource ModernTextBoxStyle}" Grid.Row="0" Grid.Column="3" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Admin user:" VerticalAlignment="Center" Margin="0,0,8,6" />
                <TextBox Style="{StaticResource ModernTextBoxStyle}" Grid.Row="1" Grid.Column="1" Text="{Binding AdminUser, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,6" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Password:" VerticalAlignment="Center" Margin="0,0,8,6" />
                <PasswordBox Style="{StaticResource ModernPasswordBoxStyle}" Grid.Row="1" Grid.Column="3" x:Name="AdminPasswordBox"
                             PasswordChanged="AdminPasswordBox_PasswordChanged" Margin="0,0,0,6" />

                <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal">
                    <CheckBox Content="Test as Windows service (temporary 'mysql_uat', removed afterwards)"
                              IsChecked="{Binding TestAsService}" Margin="0,0,20,0" VerticalAlignment="Center" />
                    <TextBlock Text="Production is stopped briefly for the copy, then restarted in its previous mode."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stages + log -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding Stages}" Margin="0,0,10,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Status}" Width="80" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ListBox Grid.Column="1" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="12" />
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Run" Command="{Binding RunCommand}" Padding="16,7" Margin="0,0,8,0" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Command="{Binding CancelCommand}" Padding="16,7" Margin="0,0,8,0" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Copy log" Click="CopyLogButton_Click" Padding="12,7" Margin="0,0,8,0"
                        ToolTip="Copy the stage results, log and report notes to the clipboard (password redacted)" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Open folder" Command="{Binding OpenFolderCommand}" Padding="12,7" Margin="0,0,8,0" />
                <Button Style="{StaticResource DangerButtonStyle}" Content="Delete UAT copy" IsEnabled="{Binding CanDeleteCopy}" Click="DeleteButton_Click" Padding="12,7" Margin="0,0,8,0" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Close" Click="CloseButton_Click" Padding="14,7" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
