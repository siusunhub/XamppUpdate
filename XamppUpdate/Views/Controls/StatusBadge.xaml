<UserControl x:Class="XamppUpdate.Views.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:XamppUpdate.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBgConverter" TargetType="Background" />
        <conv:StatusToBrushConverter x:Key="StatusToBorderConverter" TargetType="Border" />
        <conv:StatusToBrushConverter x:Key="StatusToFgConverter" TargetType="Foreground" />
        <conv:StatusToBrushConverter x:Key="StatusToDotConverter" TargetType="Dot" />
    </UserControl.Resources>

    <Border Background="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StatusToBgConverter}}"
            BorderBrush="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StatusToBorderConverter}}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="8,3"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Pulsing/Colored Status Indicator Dot -->
            <Ellipse Width="7" Height="7"
                     Fill="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StatusToDotConverter}}"
                     Margin="0,0,6,0"
                     VerticalAlignment="Center" />
            <!-- Status Text -->
            <TextBlock Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StatusToFgConverter}}"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
