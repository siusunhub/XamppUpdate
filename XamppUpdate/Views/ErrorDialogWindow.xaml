<Window x:Class="XamppUpdate.Views.ErrorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Application Debug Error Trace"
        Height="560" Width="760"
        MinHeight="420" MinWidth="580"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/app.ico"
        Background="{StaticResource WindowBgBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Buttons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header with Error Alert -->
            <RowDefinition Height="Auto" />
            <!-- Exception Summary Card -->
            <RowDefinition Height="Auto" />
            <!-- Stack Trace Section -->
            <RowDefinition Height="*" />
            <!-- Footer Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource DangerBgBrush}"
                BorderBrush="{StaticResource DangerBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left"
                        Background="#FCA5A5"
                        CornerRadius="20"
                        Width="36" Height="36"
                        Margin="0,0,12,0">
                    <TextBlock Text="⚠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle"
                               Text="An Unexpected Application Error Occurred"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource DangerFgBrush}" />
                    <TextBlock Text="A diagnostic stack trace was captured below. You can select text or click 'Copy Error Trace'."
                               FontSize="12"
                               Foreground="#7F1D1D"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Exception Summary Card -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="EXCEPTION TYPE:"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               DockPanel.Dock="Left"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <Border Background="{StaticResource PrimaryAccentSubtleBrush}"
                            CornerRadius="4"
                            Padding="6,2"
                            HorizontalAlignment="Left">
                        <TextBlock x:Name="TxtExceptionType"
                                   Text="System.Exception"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryAccentBrush}"
                                   FontFamily="Consolas, Cascadia Code, Courier New" />
                    </Border>
                    <TextBlock x:Name="TxtTimestamp"
                               Text="2026-08-29 21:00:00"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Text="MESSAGE:"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,2,0,2" />
                <TextBox x:Name="TxtMessage"
                         Text="Error message details appear here."
                         FontSize="12.5"
                         FontWeight="Medium"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Padding="0" />
            </StackPanel>
        </Border>

        <!-- Stack Trace Section (Light Theme) -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceSubtleBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="C# CALL STACK TRACE &amp; DIAGNOSTIC DETAILS"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Content="Select All"
                            Click="BtnSelectAll_Click"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource PrimaryAccentBrush}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Right"
                            Padding="6,2" />
                </DockPanel>

                <TextBox x:Name="TxtStackTrace"
                         Background="Transparent"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderThickness="0"
                         FontFamily="Consolas, Cascadia Code, Courier New"
                         FontSize="12"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         SelectionBrush="{StaticResource PrimaryAccentBrush}"
                         Padding="0" />
            </DockPanel>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Copy button & Notice -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnCopy"
                        Content="📋 Copy Error Trace"
                        Click="BtnCopy_Click"
                        Style="{StaticResource RoundedButtonStyle}"
                        Padding="16,8" />
                <Border x:Name="BorderCopiedNotice"
                        Visibility="Collapsed"
                        Background="{StaticResource SuccessBgBrush}"
                        BorderBrush="{StaticResource SuccessBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,4"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="✓ Copied to clipboard!"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessFgBrush}" />
                </Border>
            </StackPanel>

            <!-- Close button -->
            <Button Grid.Column="2"
                    Content="Close"
                    Click="BtnClose_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="22,8"
                    IsDefault="True" />
        </Grid>
    </Grid>
</Window>
