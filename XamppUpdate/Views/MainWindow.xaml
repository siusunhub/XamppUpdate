<Window x:Class="XamppUpdate.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:XamppUpdate.Views.Controls"
        xmlns:conv="clr-namespace:XamppUpdate.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="680" Width="920"
        MinHeight="550" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/app.ico"
        Background="{StaticResource WindowBgBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Brand -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0" ClipToBounds="True">
                            <Image Source="pack://application:,,,/update.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="XAMPP Component Updater" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <Border Background="{StaticResource PrimaryAccentSubtleBrush}" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppVersionDisplay}" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Local Web Server Stack Management &amp; In-Place Update Utility" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Actions: Refresh, SSL & Settings -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshStatusCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            Padding="14,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0" />
                            <TextBlock Text="Refresh Status" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenSslManagerCommand}"
                            Padding="14,8" Margin="0,0,10,0"
                            ToolTip="Inspect and update Apache SSL certificates">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒" Margin="0,0,6,0" />
                            <TextBlock Text="SSL Certificates" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenSettingsCommand}"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" Margin="0,0,6,0" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
            <StackPanel>
                <!-- Quick Notice Banner -->
                <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💡" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Apache Update Pipeline &amp; SSL Certificate Manager are ready." FontWeight="SemiBold" Foreground="#0369A1" FontSize="13" />
                            <TextBlock Text="Safely update Apache binaries, inspect configuration diffs, and manage SSL certificates and keys."
                                       Foreground="#0284C7" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Services List Header -->
                <TextBlock Text="Server Stack Components" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

                <!-- Service Cards ItemsControl -->
                <ItemsControl ItemsSource="{Binding Services}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Service Icon -->
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceSubtleBgBrush}" CornerRadius="8" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IconGlyph}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Name & Description -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,16,0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding InstallPath, StringFormat='Path: {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Version Info -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,16,0">
                                        <TextBlock Text="Installed Version" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding Version}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Status Badge -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0,16,0">
                                        <TextBlock Text="Service Status" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                        <controls:StatusBadge Status="{Binding Status}" Text="{Binding StatusText}" />
                                    </StackPanel>

                                    <!-- Action Button -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Active SSL Manager Button -->
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Content="🔒 Manage SSL"
                                                Visibility="{Binding CanManageSsl, Converter={StaticResource BoolToVisConverter}}"
                                                Command="{Binding DataContext.OpenSslManagerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Padding="14,8"
                                                ToolTip="Manage, inspect, and update SSL certificates" />

                                        <!-- Active Apache Update Button -->
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Content="Update Apache"
                                                Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisConverter}}"
                                                Command="{Binding DataContext.StartApacheUpdateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Padding="16,8" />

                                        <!-- Under Construction Disabled Button -->
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Coming Soon"
                                                IsEnabled="False"
                                                Visibility="{Binding IsUnderConstruction, Converter={StaticResource BoolToVisConverter}}"
                                                Padding="16,8" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock Text="🛡️ Administrator Privileges Active" FontSize="11" FontWeight="SemiBold" Foreground="#15803D" />
                    </Border>
                    <TextBlock Text="v0.1" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
