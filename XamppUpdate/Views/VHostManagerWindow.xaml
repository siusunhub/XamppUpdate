<Window x:Class="XamppUpdate.Views.VHostManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:XamppUpdate.Converters"
        mc:Ignorable="d"
        Title="Apache Virtual Host Manager"
        Height="800" Width="1160"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/app.ico"
        Background="{StaticResource WindowBgBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True" />
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />

        <Style x:Key="HeaderLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="CompactTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource SurfaceBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CompactComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource SurfaceBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Header & Badges -->
            <RowDefinition Height="Auto" />
            <!-- Path & Toolbar Bar -->
            <RowDefinition Height="Auto" />
            <!-- Global mod_md Settings (Collapsible) -->
            <RowDefinition Height="Auto" />
            <!-- Main VirtualHosts List -->
            <RowDefinition Height="*" />
            <!-- Edit VirtualHost Drawer / Panel -->
            <RowDefinition Height="Auto" />
            <!-- Status & Action Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Top Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌐 " FontSize="20" VerticalAlignment="Center" />
                        <TextBlock Text="Apache Virtual Host Manager" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Manage name-based and SSL virtual hosts in httpd-vhosts.conf (toggle enable/disable, ports, directories, and Let's Encrypt)."
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                </StackPanel>

                <!-- Statistics Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                        <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} Total'}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" />
                    </Border>
                    <Border Background="#DCFCE7" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                        <TextBlock Text="{Binding EnabledCount, StringFormat='{}{0} Enabled'}" FontSize="12" FontWeight="Bold" Foreground="#15803D" />
                    </Border>
                    <Border Background="#FEE2E2" CornerRadius="6" Padding="10,5" Margin="0,0,8,0"
                            Visibility="{Binding DisabledCount, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding DisabledCount, StringFormat='{}{0} Disabled'}" FontSize="12" FontWeight="Bold" Foreground="#B91C1C" />
                    </Border>
                    <Border Background="#E0F2FE" CornerRadius="6" Padding="10,5"
                            Visibility="{Binding SslCount, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding SslCount, StringFormat='{}🔒 {0} SSL'}" FontSize="12" FontWeight="Bold" Foreground="#0369A1" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Path & Toolbar Bar -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Path input and main actions -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Config File:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Text="{Binding VHostFilePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactTextBoxStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />

                    <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="📁 Browse..." Command="{Binding BrowseVHostFileCommand}" Padding="10,6" Margin="0,0,6,0" ToolTip="Browse for Apache configuration file" />
                    <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" Content="🔄 Reload" Command="{Binding LoadEntriesCommand}" Padding="10,6" Margin="0,0,6,0" ToolTip="Reload configuration from disk" />
                    <Button Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}" Content="📝 Notepad" Command="{Binding OpenInTextEditorCommand}" Padding="10,6" Margin="0,0,6,0" ToolTip="Open file directly in text editor" />
                    <Button Grid.Column="5" Style="{StaticResource SecondaryButtonStyle}" Content="⚙️ Let's Encrypt Global Settings" Command="{Binding ToggleGlobalSettingsPanelCommand}" Padding="10,6" ToolTip="Configure Apache mod_md global parameters" />
                </Grid>

                <!-- Row 1: Quick Config File Presets -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Quick Presets:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                    <Button Command="{Binding SelectPresetConfigFileCommand}" CommandParameter="vhosts"
                            Padding="10,4" Margin="0,0,8,0" ToolTip="Load primary Virtual Hosts file (conf/extra/httpd-vhosts.conf)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingVHostsFile}" Value="True">
                                        <Setter Property="Background" Value="#E0E7FF" />
                                        <Setter Property="BorderBrush" Value="#6366F1" />
                                        <Setter Property="Foreground" Value="#4338CA" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐 httpd-vhosts.conf" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SelectPresetConfigFileCommand}" CommandParameter="ssl"
                            Padding="10,4" Margin="0,0,8,0" ToolTip="Load default SSL Virtual Host file (conf/extra/httpd-ssl.conf with _default_:443)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingSslFile}" Value="True">
                                        <Setter Property="Background" Value="#E0F2FE" />
                                        <Setter Property="BorderBrush" Value="#0284C7" />
                                        <Setter Property="Foreground" Value="#0369A1" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒 httpd-ssl.conf (Default SSL)" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SelectPresetConfigFileCommand}" CommandParameter="httpd"
                            Padding="10,4" ToolTip="Load main Apache server configuration (conf/httpd.conf)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingHttpdConfFile}" Value="True">
                                        <Setter Property="Background" Value="#FEF3C7" />
                                        <Setter Property="BorderBrush" Value="#D97706" />
                                        <Setter Property="Foreground" Value="#92400E" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️ httpd.conf" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Global mod_md Settings (Collapsible) -->
        <Border Grid.Row="2" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="0,0,0,1" Padding="24,12"
                Visibility="{Binding IsGlobalSettingsPanelOpen, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="🛡️ " FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="Apache mod_md (Let's Encrypt) Global Settings" FontWeight="Bold" FontSize="14" Foreground="#15803D" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <CheckBox Content="Enable mod_md Automated SSL" IsChecked="{Binding GlobalSettings.EnableLetsEncrypt}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <CheckBox Content="MDBaseServer on" IsChecked="{Binding GlobalSettings.MdBaseServer}" ToolTip="Allow base Apache server outside VirtualHost to also manage and obtain certificate" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <Border Background="#DCFCE7" CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                            Visibility="{Binding GlobalSettings.EnableLetsEncrypt, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="✓ MDCertificateAgreement: accepted (Auto)" FontSize="11.5" FontWeight="SemiBold" Foreground="#15803D" />
                    </Border>
                </StackPanel>

                <!-- mod_md Module Configuration in httpd.conf Status Banner -->
                <Border Grid.Row="1" Margin="0,0,0,12" CornerRadius="6" Padding="12,7">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FEF2F2" />
                            <Setter Property="BorderBrush" Value="#FECACA" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsModMdConfigured}" Value="True">
                                    <Setter Property="Background" Value="#DCFCE7" />
                                    <Setter Property="BorderBrush" Value="#86EFAC" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ModMdStatusMessage}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#B91C1C" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModMdConfigured}" Value="True">
                                                <Setter Property="Foreground" Value="#15803D" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                                Content="⚡ Enable mod_md in httpd.conf"
                                Command="{Binding EnableModMdCommand}"
                                Visibility="{Binding IsModMdConfigured, Converter={StaticResource InverseBoolToVisConverter}}"
                                Padding="12,5" FontSize="12" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="MDContactEmail (Contact Email for ACME account)" Style="{StaticResource HeaderLabelStyle}" />
                        <TextBox Text="{Binding GlobalSettings.ContactEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactTextBoxStyle}" ToolTip="e.g. admin@yourdomain.com" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="MDCertificateAuthority (ACME CA Directory URL - Optional)" Style="{StaticResource HeaderLabelStyle}" />
                        <ComboBox ItemsSource="{Binding CertificateAuthorityOptions}"
                                  Text="{Binding GlobalSettings.MdCertificateAuthority, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  Style="{StaticResource CompactComboBoxStyle}"
                                  ToolTip="Select or enter ACME directory URL (Default: Let's Encrypt Production)" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 4. Main VirtualHosts Table -->
        <Border Grid.Row="3" Padding="24,16">
            <DataGrid ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      Background="{StaticResource SurfaceBgBrush}"
                      RowBackground="{StaticResource SurfaceBgBrush}"
                      AlternatingRowBackground="#FAFAFA"
                      RowHeight="44"
                      FontSize="13"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      IsReadOnly="False">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9" />
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <!-- Enable / Disable Toggle -->
                    <DataGridTemplateColumn Header="Enabled" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ToolTip="Toggle enabled or disabled (# commented)" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status Badge -->
                    <DataGridTemplateColumn Header="Status" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="11.5" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                        <Setter Property="Foreground" Value="#15803D" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Foreground" Value="#64748B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- ServerName -->
                    <DataGridTemplateColumn Header="ServerName" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource TextPrimaryBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Address & Port -->
                    <DataGridTemplateColumn Header="Port" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PortDisplayText}" VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- DocumentRoot -->
                    <DataGridTemplateColumn Header="DocumentRoot" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DocumentRoot}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DocumentRoot}" VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- SSL Mode -->
                    <DataGridTemplateColumn Header="SSL" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSsl}" Value="True">
                                                    <Setter Property="Background" Value="#E0F2FE" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSsl}" Value="False">
                                                    <Setter Property="Background" Value="#F8FAFC" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SslBadgeText}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSsl}" Value="True">
                                                        <Setter Property="Foreground" Value="#0284C7" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSsl}" Value="False">
                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="Actions" Width="215">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="✏️ Edit"
                                            Padding="8,4" FontSize="11.5" Margin="0,0,6,0"
                                            Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="🔒 Cert"
                                            Padding="6,4" FontSize="11.5" Margin="0,0,6,0"
                                            Command="{Binding DataContext.ViewEntryCertificateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Inspect SSL certificate information for this virtual host"
                                            Visibility="{Binding IsSsl, Converter={StaticResource BoolToVisConverter}}" />
                                    <Button Style="{StaticResource DangerButtonStyle}"
                                            Content="🗑️ Delete"
                                            Padding="8,4" FontSize="11.5"
                                            Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 5. Edit VirtualHost Drawer / Panel -->
        <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12"
                Visibility="{Binding IsEditPanelOpen, Converter={StaticResource BoolToVisConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="520">
                <Border Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Edit Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✏️ " FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="Editing VirtualHost: " FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedEntry.DisplayText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SuccessButtonStyle}"
                                    Content="✓ Save &amp; Close"
                                    Command="{Binding SaveAndCloseEditCommand}"
                                    Padding="14,6" Margin="0,0,8,0" FontSize="12.5" FontWeight="Bold"
                                    ToolTip="Apply changes to this virtual host and close edit panel" />

                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="✕ Discard &amp; Close"
                                    Command="{Binding DiscardAndCloseEditCommand}"
                                    Padding="14,6" FontSize="12.5"
                                    ToolTip="Discard changes (or remove newly added entry) and close edit panel" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Basic Host Settings -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ServerName *" Style="{StaticResource HeaderLabelStyle}" />
                            <TextBox Text="{Binding SelectedEntry.ServerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactTextBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ServerAlias" Style="{StaticResource HeaderLabelStyle}" />
                            <TextBox Text="{Binding SelectedEntry.ServerAlias, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactTextBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Listen Address" Style="{StaticResource HeaderLabelStyle}" />
                            <TextBox Text="{Binding SelectedEntry.ListenAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactTextBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Port *" Style="{StaticResource HeaderLabelStyle}" />
                            <TextBox Text="{Binding SelectedEntry.Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactTextBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: DocumentRoot & DirectoryIndex -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DocumentRoot *" Style="{StaticResource HeaderLabelStyle}" />
                            <TextBox Text="{Binding SelectedEntry.DocumentRoot, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactTextBoxStyle}" />
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="📁 Browse..." Command="{Binding BrowseDocumentRootCommand}" VerticalAlignment="Bottom" Padding="10,6" />
                        <Button Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}" Content="📂 Explore" Command="{Binding OpenDocRootInExplorerCommand}" VerticalAlignment="Bottom" Padding="10,6" />

                        <StackPanel Grid.Column="6">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DirectoryIndex" Style="{StaticResource HeaderLabelStyle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Default"
                                        Command="{Binding SetDefaultDirectoryIndexCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontSize="11" Padding="6,2"
                                        ToolTip="Fill with standard: index.php index.html index.htm" />
                            </Grid>
                            <TextBox Text="{Binding SelectedEntry.DirectoryIndex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactTextBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 3: SSL & Let's Encrypt -->
                    <Border Grid.Row="3" Background="#F1F5F9" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox Content="Enable SSL (HTTPS / SSLEngine on)"
                                          IsChecked="{Binding SelectedEntry.IsSsl, UpdateSourceTrigger=PropertyChanged}"
                                          FontWeight="Bold" FontSize="13" Margin="0,0,24,0" />

                                <CheckBox Content="🛡️ Use Let's Encrypt Auto-Renewal (mod_md)"
                                          IsChecked="{Binding SelectedEntry.UseLetsEncrypt, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding SelectedEntry.IsSsl}"
                                          Visibility="{Binding SelectedEntry.IsSsl, Converter={StaticResource BoolToVisConverter}}"
                                          FontWeight="SemiBold" FontSize="13" />

                                <Border Background="#DCFCE7" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Margin="14,0,0,0"
                                        Visibility="{Binding SelectedEntry.UseLetsEncrypt, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="✓ MDCertificateAgreement: accepted" FontSize="11" FontWeight="SemiBold" Foreground="#15803D" />
                                </Border>
                            </StackPanel>

                            <!-- Warning if mod_md is not enabled in httpd.conf -->
                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                                    Visibility="{Binding DataContext.IsModMdWarningVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="⚠️ 'mod_md' is not enabled in httpd.conf. Let's Encrypt automated certificates will not be active until enabled."
                                                   FontSize="11.5" Foreground="#B91C1C" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DataContext.ModMdStatusMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="11" Foreground="#991B1B" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                                            Content="⚡ Enable mod_md in httpd.conf"
                                            Command="{Binding DataContext.EnableModMdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Padding="12,5" FontSize="11.5" FontWeight="SemiBold" Margin="12,0,0,0" />
                                </Grid>
                            </Border>

                            <!-- SSL Certificate Files (custom cert, or the startup fallback when using Let's Encrypt) -->
                            <StackPanel Visibility="{Binding SelectedEntry.IsSsl, Converter={StaticResource BoolToVisConverter}}">
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                                        Visibility="{Binding SelectedEntry.UseLetsEncrypt, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#1E40AF"
                                               Text="ℹ️ Fallback certificate: Apache needs a certificate to start before mod_md has issued the Let's Encrypt one (otherwise AH02572 'no certificate assigned'). The files below are only this startup fallback; the issued Let's Encrypt certificate is shown in Certificate Information." />
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Cert File -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SSLCertificateFile" Style="{StaticResource HeaderLabelStyle}" />
                                        <TextBox Text="{Binding SelectedEntry.SslCertificateFile, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactTextBoxStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="📁" Command="{Binding BrowseSslCertCommand}" VerticalAlignment="Bottom" Padding="8,6" ToolTip="Browse for certificate file" />

                                    <!-- Key File -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="SSLCertificateKeyFile" Style="{StaticResource HeaderLabelStyle}" />
                                        <TextBox Text="{Binding SelectedEntry.SslCertificateKeyFile, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactTextBoxStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="6" Style="{StaticResource SecondaryButtonStyle}" Content="📁" Command="{Binding BrowseSslKeyCommand}" VerticalAlignment="Bottom" Padding="8,6" ToolTip="Browse for private key file" />

                                    <!-- Chain File -->
                                    <StackPanel Grid.Column="8">
                                        <TextBlock Text="SSLCertificateChainFile (Optional)" Style="{StaticResource HeaderLabelStyle}" />                                        <TextBox Text="{Binding SelectedEntry.SslCertificateChainFile, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactTextBoxStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="10" Style="{StaticResource SecondaryButtonStyle}" Content="📁" Command="{Binding BrowseSslChainCommand}" VerticalAlignment="Bottom" Padding="8,6" ToolTip="Browse for CA chain file" />
                                </Grid>
                            </StackPanel>

                            <!-- Certificate Information Card (Shown when SSL is enabled) -->
                            <Border Margin="0,12,0,0" Padding="14,12" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8"
                                    Visibility="{Binding SelectedEntry.IsSsl, Converter={StaticResource BoolToVisConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header: Title + Badges + Action Buttons -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🛡️ Certificate Information" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                                            <!-- Status Badge -->
                                            <Border Background="{Binding CurrentCertInfo.StatusBadgeBackground}"
                                                    CornerRadius="4" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding CurrentCertInfo, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="{Binding CurrentCertInfo.StatusDisplayText}"
                                                           Foreground="{Binding CurrentCertInfo.StatusBadgeForeground}"
                                                           FontSize="11" FontWeight="Bold" />
                                            </Border>

                                            <!-- Source Mode Badge -->
                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="8,3" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding CurrentCertInfo, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="{Binding CurrentCertInfo.CertSourceType}" Foreground="#475569" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="🔄 Refresh"
                                                    Command="{Binding RefreshCertInfoCommand}"
                                                    Padding="8,4" FontSize="11" Margin="0,0,6,0"
                                                    ToolTip="Refresh certificate details from disk" />

                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="📁 Open Folder"
                                                    Command="{Binding OpenCertFolderInExplorerCommand}"
                                                    IsEnabled="{Binding CurrentCertInfo.CanOpenFolder}"
                                                    Padding="8,4" FontSize="11" Margin="0,0,6,0"
                                                    ToolTip="Open certificate file location in Explorer" />

                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    Content="🔍 View Certificate Details"
                                                    Command="{Binding ViewCertificateInViewerCommand}"
                                                    IsEnabled="{Binding CurrentCertInfo.CanViewCertificate}"
                                                    Padding="10,4" FontSize="11" FontWeight="SemiBold"
                                                    ToolTip="Open in Windows Certificate Details Viewer" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Separator -->
                                    <Border Grid.Row="1" Height="1" Background="#E2E8F0" Margin="0,10,0,10" />

                                    <!-- Grid Details -->
                                    <Grid Grid.Row="2" Visibility="{Binding CurrentCertInfo, Converter={StaticResource BoolToVisConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: 4 Information Columns -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.5*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="1.5*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Storage Path -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="CERTIFICATE FILE LOCATION ON DISK" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3" />
                                                <TextBox Text="{Binding CurrentCertInfo.CertificateFilePath, Mode=OneWay}"
                                                         IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                         FontSize="11.5" FontFamily="Consolas" TextWrapping="Wrap" Foreground="#0F172A" Padding="0" />
                                            </StackPanel>

                                            <!-- CN & SAN -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="COMMON NAME (CN) &amp; DOMAINS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3" />
                                                <TextBlock Text="{Binding CurrentCertInfo.CommonName, TargetNullValue='(Not read)'}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CurrentCertInfo.SanList}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                           Visibility="{Binding CurrentCertInfo.SanList, Converter={StaticResource BoolToVisConverter}}" />
                                            </StackPanel>

                                            <!-- Issuer -->
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="ISSUER / CA" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3" />
                                                <TextBlock Text="{Binding CurrentCertInfo.Issuer, TargetNullValue='(Not read)'}" FontSize="12" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Validity & Expiration -->
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="EXPIRES / VALID TO" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3" />
                                                <TextBlock Text="{Binding CurrentCertInfo.ValidToDisplayText}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" />
                                                <TextBlock Text="{Binding CurrentCertInfo.DaysRemaining, StringFormat='{}{0} days remaining'}" FontSize="11" Foreground="{Binding CurrentCertInfo.StatusBadgeForeground}" FontWeight="SemiBold"
                                                           Visibility="{Binding CurrentCertInfo.CertificateFileExists, Converter={StaticResource BoolToVisConverter}}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Row 1: Key & Extra Status/Message -->
                                        <Border Grid.Row="1" Margin="0,10,0,0" Padding="10,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Private Key File: " FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" />
                                                        <TextBlock Text="{Binding CurrentCertInfo.KeyFilePath, TargetNullValue='(None)'}" FontSize="11.5" FontFamily="Consolas" Foreground="#0F172A" />
                                                        <TextBlock Text="  •  Status: " FontSize="11.5" Foreground="#64748B" />
                                                        <TextBlock Text="{Binding CurrentCertInfo.KeyStatusDisplayText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" />
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding CurrentCertInfo.ErrorMessage}" FontSize="11.5" Foreground="#B45309" Margin="0,4,0,0" TextWrapping="Wrap"
                                                               Visibility="{Binding CurrentCertInfo.ErrorMessage, Converter={StaticResource BoolToVisConverter}}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Valid From: " FontSize="11.5" Foreground="#64748B" />
                                                    <TextBlock Text="{Binding CurrentCertInfo.ValidFromDisplayText}" FontSize="11.5" Foreground="#334155" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Row 4: Logging -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ErrorLog" Style="{StaticResource HeaderLabelStyle}" />
                            <TextBox Text="{Binding SelectedEntry.ErrorLog, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactTextBoxStyle}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="📁 Browse..." Command="{Binding BrowseErrorLogCommand}" VerticalAlignment="Bottom" Padding="10,6" />

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="CustomLog (Access Log)" Style="{StaticResource HeaderLabelStyle}" />
                            <TextBox Text="{Binding SelectedEntry.CustomLog, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactTextBoxStyle}" />
                        </StackPanel>
                        <Button Grid.Column="6" Style="{StaticResource SecondaryButtonStyle}" Content="📁 Browse..." Command="{Binding BrowseCustomLogCommand}" VerticalAlignment="Bottom" Padding="10,6" />
                    </Grid>


                </Grid>
            </Border>
            </ScrollViewer>
        </Border>

        <!-- 6. Status & Action Footer -->
        <Border Grid.Row="5" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Message -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Border Background="#FEF3C7" CornerRadius="4" Padding="8,2" Margin="12,0,0,0"
                            Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="● Unsaved Changes" FontSize="11.5" FontWeight="Bold" Foreground="#B45309" />
                    </Border>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="➕ Add New vHost"
                            Command="{Binding AddEntryCommand}"
                            Padding="16,8" Margin="0,0,10,0" />

                    <Button Style="{StaticResource SuccessButtonStyle}"
                            Content="💾 Save Changes"
                            Command="{Binding SaveEntriesCommand}"
                            Padding="20,8" Margin="0,0,10,0" />

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="Close"
                            Click="CloseButton_Click"
                            Padding="16,8" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
