<Window x:Class="XamppUpdate.Views.ApacheUpdateWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:XamppUpdate.Views.Controls"
        xmlns:conv="clr-namespace:XamppUpdate.Converters"
        mc:Ignorable="d"
        Title="Apache HTTP Server Update Wizard"
        Height="720" Width="1060"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/app.ico"
        Background="{StaticResource WindowBgBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True" />
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <conv:ResolutionToBooleanConverter x:Key="ResolutionToBoolConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Wizard Step Header Indicator -->
            <RowDefinition Height="Auto" />
            <!-- Active Step Content Area -->
            <RowDefinition Height="*" />
            <!-- Wizard Footer Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Wizard Step Header Indicator -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Title & Version Info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Apache Update Pipeline" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding CurrentInstalledVersion, StringFormat='Active Installed Version: {0}'}"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Steps Breadcrumb -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Step 1 Indicator -->
                    <Border Background="{Binding CurrentStepIndex, Converter={StaticResource BoolToVisConverter}}" CornerRadius="6" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource PrimaryAccentBrush}" Margin="0,0,6,0">
                                <TextBlock Text="1" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Source Package" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="→" Foreground="{StaticResource TextMutedBrush}" FontSize="14" Margin="10,0" VerticalAlignment="Center" />

                    <!-- Step 2 Indicator -->
                    <Border CornerRadius="6" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource PrimaryAccentBrush}" Margin="0,0,6,0">
                                <TextBlock Text="2" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Config Diff &amp; Merge" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="→" Foreground="{StaticResource TextMutedBrush}" FontSize="14" Margin="10,0" VerticalAlignment="Center" />

                    <!-- Step 3 Indicator -->
                    <Border CornerRadius="6" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource PrimaryAccentBrush}" Margin="0,0,6,0">
                                <TextBlock Text="3" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Execute Update" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Step Content Switcher -->
        <Grid Grid.Row="1" Margin="24,18">

            <!-- ================= STEP 1: SOURCE SELECTION ================= -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStepIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel VerticalAlignment="Top" MaxWidth="800" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Step 1: Select Apache Update Source" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="Provide an Apache distribution archive (.zip or .7z) downloaded from Apache Lounge or enter a direct download URL."
                                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />

                            <!-- Apache Lounge Download Link Banner -->
                            <Border Background="{StaticResource PrimaryAccentSubtleBrush}"
                                    BorderBrush="#BAE6FD"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🌐 " FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Text="Download Latest Apache Win64 Binaries:" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="https://www.apachelounge.com/download/"
                                                   Foreground="#0369A1"
                                                   FontSize="12"
                                                   FontFamily="Consolas, Cascadia Code, Courier New"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource RoundedButtonStyle}"
                                            Command="{Binding OpenApacheLoungeUrlCommand}"
                                            ToolTip="Open https://www.apachelounge.com/download/ in web browser"
                                            Padding="14,6"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔗 Open Download Page" Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="SemiBold" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Source Input -->
                            <TextBlock Text="Archive File Path or Download URL:" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding SourcePathOrUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,10" FontSize="13" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                        Content="📁 Browse Local File..."
                                        Command="{Binding BrowseLocalFileCommand}"
                                        Margin="10,0,0,0" Padding="14,10" />
                            </Grid>

                            <!-- Helpful Tips -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="💡 Supported formats &amp; sources:" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock Text="• Official Apache Lounge x64 zip: https://www.apachelounge.com/download/ (e.g. httpd-2.4.63-250207-win64-VS17.zip)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                    <TextBlock Text="• Archives with nested 'Apache24/' or direct root files are automatically resolved." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                                    <TextBlock Text="• The existing configuration will be compared and safely preserved." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Progress & Status during Step 1 -->
                            <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,16">
                                <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,0,6" />
                                <ProgressBar Style="{StaticResource ModernProgressBarStyle}"
                                             Value="{Binding ProgressPercentage}"
                                             IsIndeterminate="{Binding IsIndeterminateProgress}" />
                            </StackPanel>

                            <!-- Error Message Banner -->
                            <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,10"
                                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️ " FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Action Button -->
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Extract &amp; Inspect Config Files →"
                                    Command="{Binding ProcessStep1Command}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                    HorizontalAlignment="Right"
                                    Padding="20,10" FontSize="13.5" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ================= STEP 2: CONFIG DIFF & MERGE ================= -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStepIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Step 2 Header Info -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Step 2: Configuration Diff &amp; Merge Preview" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Inspect line-by-line differences between your current working configs and the incoming Apache package."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#E0F2FE" CornerRadius="6" Padding="10,4">
                                <TextBlock Text="{Binding IncomingDetectedVersion, StringFormat='Incoming Version: {0}'}"
                                           Foreground="#0369A1" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Diff Workspace (Left: Files List, Right: Side-by-side Diff Viewer) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Config Files List -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="TARGET CONFIG FILES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="4,2,4,8" />
                            <ListBox ItemsSource="{Binding DiffItems}"
                                     SelectedItem="{Binding SelectedDiffItem}"
                                     BorderThickness="0"
                                     Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,8" Margin="0,2" CornerRadius="6" Background="{StaticResource SurfaceSubtleBgBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding RelativeFilePath}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Right: Diff Viewer & Resolution Picker -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Diff Viewer Area -->
                                <RowDefinition Height="*" />
                                <!-- File Action Selector -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Side-by-Side Diff UserControl -->
                            <controls:SideBySideDiffViewer Grid.Row="0" DiffItem="{Binding SelectedDiffItem}" />

                            <!-- Per-File Resolution Selector -->
                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Config Resolution for this file:" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton Style="{StaticResource ModernRadioButtonStyle}"
                                                     Content="Preserve Current Local (Recommended)"
                                                     IsChecked="{Binding SelectedDiffItem.Resolution, Converter={StaticResource ResolutionToBoolConverter}, ConverterParameter=KeepCurrent}"
                                                     FontWeight="SemiBold"
                                                     Margin="0,0,20,0" />

                                        <RadioButton Style="{StaticResource ModernRadioButtonStyle}"
                                                     Content="Overwrite with Incoming Default"
                                                     IsChecked="{Binding SelectedDiffItem.Resolution, Converter={StaticResource ResolutionToBoolConverter}, ConverterParameter=OverwriteWithNew}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Step 2 Navigation Buttons -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                            Content="← Back to Source"
                            Command="{Binding GoBackToStep1Command}"
                            Padding="16,8" />

                    <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                            Content="Proceed to Pre-Flight Check →"
                            Command="{Binding ProceedToStep3Command}"
                            Padding="18,8" />
                </Grid>
            </Grid>

            <!-- ================= STEP 3: CONFIRMATION & EXECUTION ================= -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStepIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Step 3 Checklist Card -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Step 3: Update Execution Pipeline Checklist" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="✓ 1. Automated Full Backup of active Apache directory" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                                <TextBlock Text="✓ 2. Graceful Windows Service Stop &amp; Verification" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                                <TextBlock Text="✓ 3. Replace Binaries, Modules &amp; Assets" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="✓ 4. Apply configured config file choices" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                                <TextBlock Text="✓ 5. Restart Windows Service &amp; Verify Status" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                                <TextBlock Text="✓ 6. Cleanup Temporary Workspace Files" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Live Progress & Execution Log Console -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Progress Bar & Status -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:0}%'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <ProgressBar Grid.Row="1" Style="{StaticResource ModernProgressBarStyle}"
                                     Value="{Binding ProgressPercentage}"
                                     IsIndeterminate="{Binding IsIndeterminateProgress}"
                                     Height="10" Margin="0,0,0,12" />

                        <!-- Log Console -->
                        <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="EXECUTION LOG" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" />
                                <ListBox ItemsSource="{Binding ExecutionLogs}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#E2E8F0"
                                         FontFamily="Consolas, Cascadia Mono, Courier New"
                                         FontSize="12" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Step 3 Action Footer -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                            Content="← Back to Config Diff"
                            Command="{Binding GoBackToStep2Command}"
                            Visibility="{Binding IsExecuting, Converter={StaticResource InverseBoolToVisConverter}}"
                            IsEnabled="{Binding IsCompleted, Converter={StaticResource InverseBoolConverter}}"
                            Padding="16,8" />

                    <!-- Success Message Banner -->
                    <Border Grid.Column="1" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="16,0"
                            Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🎉 Apache Update Succeeded!" FontWeight="Bold" Foreground="#15803D" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <!-- Error Banner -->
                    <Border Grid.Column="1" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="16,0"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Start Execution Button -->
                        <Button Style="{StaticResource SuccessButtonStyle}"
                                Content="🚀 Execute Update Now"
                                Command="{Binding ExecuteUpdatePipelineCommand}"
                                Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVisConverter}}"
                                IsEnabled="{Binding IsExecuting, Converter={StaticResource InverseBoolConverter}}"
                                Padding="20,10" FontSize="13.5" />

                        <!-- Finish Button -->
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Done &amp; Close"
                                Command="{Binding CancelOrCloseCommand}"
                                Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisConverter}}"
                                Padding="22,10" FontSize="13.5" />
                    </StackPanel>
                </Grid>
            </Grid>

        </Grid>

        <!-- Bottom Modal Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="XAMPP Local Server Updater • Step-by-Step Guided Wizard" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel &amp; Close" Command="{Binding CancelOrCloseCommand}" Padding="12,6" />
            </Grid>
        </Border>
    </Grid>
</Window>
