<Window x:Class="XamppUpdate.Views.ApacheUpdateWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:XamppUpdate.Views.Controls"
        xmlns:conv="clr-namespace:XamppUpdate.Converters"
        mc:Ignorable="d"
        Title="Apache HTTP Server Update Wizard"
        Height="720" Width="1060"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/app.ico"
        Background="{StaticResource WindowBgBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True" />
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <conv:ResolutionToBooleanConverter x:Key="ResolutionToBoolConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Wizard Step Header Indicator -->
            <RowDefinition Height="Auto" />
            <!-- Active Step Content Area -->
            <RowDefinition Height="*" />
            <!-- Wizard Footer Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Wizard Step Header Indicator -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Title & Version Info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Apache Update Pipeline" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentInstalledVersion, StringFormat='Active Installed Version: {0}'}"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Steps Breadcrumb -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Step 1 Indicator -->
                    <Border CornerRadius="14" Padding="12,4" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepIndex}" Value="0">
                                        <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="1. Source Selection" FontWeight="SemiBold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepIndex}" Value="0">
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="→" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,6,0" />

                    <!-- Step 2 Indicator -->
                    <Border CornerRadius="14" Padding="12,4" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepIndex}" Value="1">
                                        <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="2. Config Diff &amp; Merge" FontWeight="SemiBold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepIndex}" Value="1">
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="→" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,6,0" />

                    <!-- Step 3 Indicator -->
                    <Border CornerRadius="14" Padding="12,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepIndex}" Value="2">
                                        <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="3. Stop Apache &amp; Execute" FontWeight="SemiBold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepIndex}" Value="2">
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Step Content Switcher -->
        <Grid Grid.Row="1" Margin="24,18">

            <!-- ================= STEP 1: SOURCE SELECTION ================= -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStepIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,4,0,20">
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="28">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="🌐" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Select Apache HTTP Server Package" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Provide an Apache distribution archive (.zip or .7z) downloaded from Apache Lounge or enter a direct download URL." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Active Installed Apache Build Card -->
                                <Border Background="{StaticResource SurfaceSubtleBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Active Installed Apache Build:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding CurrentInstalledVersion, StringFormat='Apache {0}'}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0" />
                                                <Border Background="#EEF2F6" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="Win64 / VC17" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Apache Lounge Download Link Banner -->
                                <Border Background="{StaticResource SurfaceBgBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🌐 " FontSize="13" VerticalAlignment="Center" />
                                                <TextBlock Text="Download Latest Apache Win64 Binaries:" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="12.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="https://www.apachelounge.com/download/"
                                                       Foreground="#0369A1"
                                                       FontSize="12"
                                                       FontFamily="Consolas, Cascadia Code, Courier New"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding OpenApacheLoungeUrlCommand}"
                                                ToolTip="Open https://www.apachelounge.com/download/ in web browser"
                                                Padding="14,6"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔗 Open Download Page" FontWeight="SemiBold" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Source Input -->
                                <TextBlock Text="Archive File Path or Download URL:" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding SourcePathOrUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="12,10" FontSize="13" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                            Content="📂 Browse Local File..."
                                            Command="{Binding BrowseLocalFileCommand}"
                                            Margin="10,0,0,0" Padding="14,10" />
                                </Grid>

                                <!-- Helpful Tips -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="💡 Supported formats &amp; sources:" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                        <TextBlock Text="• Official Apache Lounge x64 zip: https://www.apachelounge.com/download/ (e.g. httpd-2.4.63-250207-win64-VS17.zip)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                        <TextBlock Text="• Archives with nested 'Apache24/' or direct root files are automatically resolved." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                                        <TextBlock Text="• The existing configuration will be compared and safely preserved." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Progress & Status during Step 1 -->
                                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding StatusMessage}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryAccentBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               Margin="0,0,0,6" />
                                    <ProgressBar Style="{StaticResource ModernProgressBarStyle}"
                                                 Value="{Binding ProgressPercentage}"
                                                 IsIndeterminate="{Binding IsIndeterminateProgress}" />
                                </StackPanel>

                                <!-- Error Message Banner -->
                                <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,10"
                                        Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠️ " FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Action Buttons: Left Tool Button + Right Next Button -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Side: Default SSL Cert Tool Button + Manage vHost Button + Service Management Buttons -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="🛡️ Generate Default SSL Cert"
                                                Command="{Binding OpenGenerateDefaultCertCommand}"
                                                Padding="14,10" FontSize="13"
                                                ToolTip="Renew expired or missing default XAMPP SSL certificates (conf/ssl.crt/server.crt)" />

                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="🌐 Manage vHost"
                                                Command="{Binding OpenVHostManagerCommand}"
                                                Padding="14,10" FontSize="13"
                                                Margin="10,0,0,0"
                                                ToolTip="Add, edit, delete and manage Apache VirtualHost entries in httpd-vhosts.conf" />

                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{Binding ServiceInstallButtonText}"
                                                Command="{Binding ToggleServiceInstallCommand}"
                                                IsEnabled="{Binding CanToggleServiceInstall}"
                                                Padding="14,10" FontSize="13"
                                                Margin="10,0,0,0"
                                                ToolTip="Install or remove Apache Windows service (only available while Apache is stopped)" />

                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{Binding ServiceRunButtonText}"
                                                Command="{Binding ToggleServiceRunCommand}"
                                                IsEnabled="{Binding IsOperatingService, Converter={StaticResource InverseBoolConverter}}"
                                                Padding="14,10" FontSize="13"
                                                Margin="10,0,0,0"
                                                ToolTip="Start or stop Apache (via Windows service if installed, or background process if not installed)" />
                                    </StackPanel>

                                    <!-- Right Side: Next Step Button -->
                                    <Button Grid.Column="2"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Content="Next"
                                            Command="{Binding ProcessStep1Command}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                            Padding="24,10" FontSize="13.5" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= STEP 2: CONFIG DIFF & MERGE ================= -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStepIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Step 2 Header Info -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Step 2: Configuration Diff &amp; Merge Preview" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Inspect line-by-line differences between your current working configs and the incoming Apache package."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="12,5">
                                <TextBlock Text="{Binding VersionTransitionDisplay}"
                                           Foreground="#0369A1" FontSize="12" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Diff Workspace: 100% Full Width with Top Pulldown Selector -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Top Bar: Target Config File Selector Pulldown -->
                            <RowDefinition Height="Auto" />
                            <!-- Diff Viewer Area: 100% Full Width -->
                            <RowDefinition Height="*" />
                            <!-- File Action Selector -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Bar: Pulldown Selector -->
                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="TARGET CONFIG FILE:" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding DiffItems}"
                                          SelectedItem="{Binding SelectedDiffItem}"
                                          Height="34"
                                          FontSize="13"
                                          VerticalContentAlignment="Center"
                                          Background="#FFFFFF"
                                          BorderBrush="{StaticResource BorderBrush}"
                                          BorderThickness="1"
                                          Padding="8,3"
                                          Cursor="Hand"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Padding" Value="8,5" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ComboBoxItem">
                                                        <Border x:Name="ItemBorder"
                                                                Background="Transparent"
                                                                CornerRadius="6"
                                                                Margin="2,1"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#E0F2FE" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="📄 " FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding RelativeFilePath}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,16,0" />
                                                <Border Grid.Column="2"
                                                        Background="{Binding BadgeBackgroundBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SummaryText}"
                                                               Foreground="{Binding BadgeForegroundBrush}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Border Background="#EEF2F6" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="{Binding DiffItems.Count, StringFormat='{}{0} files'}"
                                                   FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Side-by-Side Diff UserControl (100% Full Width!) -->
                        <controls:SideBySideDiffViewer Grid.Row="1" DiffItem="{Binding SelectedDiffItem}" />

                        <!-- Per-File Resolution Selector -->
                        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Config Resolution for this file:" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Style="{StaticResource ModernRadioButtonStyle}"
                                                 Content="Preserve Current Local (Recommended)"
                                                 IsChecked="{Binding SelectedDiffItem.Resolution, Converter={StaticResource ResolutionToBoolConverter}, ConverterParameter=KeepCurrent}"
                                                 FontWeight="SemiBold"
                                                 Margin="0,0,16,0" />

                                    <RadioButton Style="{StaticResource ModernRadioButtonStyle}"
                                                 Content="Overwrite with Incoming Default"
                                                 IsChecked="{Binding SelectedDiffItem.Resolution, Converter={StaticResource ResolutionToBoolConverter}, ConverterParameter=OverwriteWithNew}"
                                                 FontWeight="SemiBold"
                                                 Margin="0,0,16,0" />

                                    <RadioButton Style="{StaticResource ModernRadioButtonStyle}"
                                                 Content="Use Custom Merged / Edited"
                                                 IsChecked="{Binding SelectedDiffItem.Resolution, Converter={StaticResource ResolutionToBoolConverter}, ConverterParameter=UseMerged}"
                                                 FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Step 2 Navigation Buttons -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                            Content="⬅️ Back to Source"
                            Command="{Binding GoBackToStep1Command}"
                            Padding="16,8" />

                    <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                            Content="📋 Next: Review &amp; Execute Pipeline →"
                            Command="{Binding ProceedToStep3Command}"
                            Padding="20,10" FontSize="13.5" />
                </Grid>
            </Grid>

            <!-- ================= STEP 3: CONFIRMATION & EXECUTION ================= -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStepIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Step 3 Checklist Card -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Step 3: Update Execution Pipeline Checklist" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="10,3">
                                <TextBlock Text="{Binding VersionTransitionDisplay}" Foreground="#0369A1" FontSize="11.5" FontWeight="Bold" />
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="✓ 1. Automated Full Backup of active Apache directory" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                                <TextBlock Text="✓ 2. Graceful Windows Service Stop &amp; Verification" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                                <TextBlock Text="✓ 3. Replace Binaries, Modules &amp; Assets" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="✓ 4. Apply configured config file choices" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                                <TextBlock Text="✓ 5. Restart Windows Service &amp; Verify Status" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                                <TextBlock Text="✓ 6. Cleanup Temporary Workspace Files" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Live Progress & Execution Log Console -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Progress Bar & Status -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                    Content="📋 Copy Logs"
                                    Command="{Binding CopyExecutionLogsCommand}"
                                    Padding="10,3" FontSize="11" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="2" Text="{Binding ProgressPercentage, StringFormat='{}{0:0}%'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <ProgressBar Grid.Row="1" Style="{StaticResource ModernProgressBarStyle}"
                                     Value="{Binding ProgressPercentage}"
                                     IsIndeterminate="{Binding IsIndeterminateProgress}"
                                     Height="10" Margin="0,0,0,12" />

                        <!-- Log Console (Light Theme) -->
                        <Border Grid.Row="2"
                                Background="{StaticResource SurfaceSubtleBgBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="EXECUTION LOG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <ListBox ItemsSource="{Binding ExecutionLogs}"
                                         controls:AutoScrollBehavior.AutoScroll="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                         FontSize="12" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Step 3 Action Footer -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                            Content="⬅️ Back to Config Diff"
                            Command="{Binding GoBackToStep2Command}"
                            Visibility="{Binding IsExecuting, Converter={StaticResource InverseBoolToVisConverter}}"
                            IsEnabled="{Binding IsCompleted, Converter={StaticResource InverseBoolConverter}}"
                            Padding="16,8" />

                    <!-- Success Message Banner -->
                    <Border Grid.Column="1" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="16,0"
                            Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🧪 Simulation Completed! Ready to update."
                                       FontWeight="Bold" Foreground="#15803D" FontSize="12.5"
                                       Visibility="{Binding IsTestCompleted, Converter={StaticResource BoolToVisConverter}}" />
                            <TextBlock Text="🎉 Apache Update Succeeded!"
                                       FontWeight="Bold" Foreground="#15803D" FontSize="12.5"
                                       Visibility="{Binding IsTestCompleted, Converter={StaticResource InverseBoolToVisConverter}}" />
                        </StackPanel>
                    </Border>

                    <!-- Error Banner -->
                    <Border Grid.Column="1" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="16,0"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Before Completion: Both Buttons Side-by-Side -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVisConverter}}">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="🧪 Run Test Mode Simulation"
                                    Command="{Binding RunTestModeSimulationCommand}"
                                    IsEnabled="{Binding IsExecuting, Converter={StaticResource InverseBoolConverter}}"
                                    Padding="16,10" Margin="0,0,10,0" FontSize="13" />

                            <Button Style="{StaticResource SuccessButtonStyle}"
                                    Content="🚀 Execute Real Update Now"
                                    Command="{Binding ExecuteRealUpdateCommand}"
                                    IsEnabled="{Binding IsExecuting, Converter={StaticResource InverseBoolConverter}}"
                                    Padding="20,10" FontSize="13.5" />
                        </StackPanel>

                        <!-- After Test Mode Completed: Can Re-test or Real Start Exec -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsTestCompleted, Converter={StaticResource BoolToVisConverter}}">
                            <CheckBox Content="⚡ Skip backup in real update (already verified)"
                                      IsChecked="{Binding SkipBackupDuringRealUpdate}"
                                      VerticalAlignment="Center"
                                      FontWeight="SemiBold" FontSize="12.5"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,0,14,0" />

                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="🔄 Re-Test Simulation"
                                    Command="{Binding ReTestSimulationCommand}"
                                    Padding="16,10" Margin="0,0,10,0" FontSize="13" />

                            <Button Style="{StaticResource SuccessButtonStyle}"
                                    Content="🚀 Execute Real Update Now"
                                    Command="{Binding ExecuteRealUpdateAfterTestCommand}"
                                    Padding="18,10" Margin="0,0,10,0" FontSize="13" />
                        </StackPanel>

                        <!-- Finish / Done Button -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisConverter}}">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="✅ Done &amp; Close"
                                    Command="{Binding CancelOrCloseCommand}"
                                    Visibility="{Binding IsTestCompleted, Converter={StaticResource InverseBoolToVisConverter}}"
                                    Padding="20,10" FontSize="13.5" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

        </Grid>

        <!-- Bottom Modal Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Left: live service / process state (kept here so it never collides with the step breadcrumb) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Apache:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <controls:StatusBadge Status="{Binding ServiceStatus}" Text="{Binding ServiceStatusDisplay}" VerticalAlignment="Center" />
                    <TextBlock Text="•  XAMPP Local Server Updater" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="✕ Cancel &amp; Close" Command="{Binding CancelOrCloseCommand}" Padding="12,6" />
            </Grid>
        </Border>
    </Grid>
</Window>
