<Window x:Class="XamppUpdate.Views.MySqlUpdateWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:XamppUpdate.Views.Controls"
        xmlns:conv="clr-namespace:XamppUpdate.Converters"
        mc:Ignorable="d"
        Title="MySQL / MariaDB Database Update Wizard"
        Height="740" Width="1080"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/app.ico"
        Background="{StaticResource WindowBgBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True" />
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <conv:ResolutionToBooleanConverter x:Key="ResolutionToBoolConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Wizard Step Header Indicator -->
            <RowDefinition Height="Auto" />
            <!-- Active Step Content Area -->
            <RowDefinition Height="*" />
            <!-- Wizard Footer Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Wizard Step Header Indicator -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Title & Version Info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="MySQL / MariaDB Update Pipeline" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding CurrentInstalledVersion, StringFormat='Active Installed Version: {0}'}"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Steps Breadcrumb -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Step 1 Indicator -->
                    <Border CornerRadius="14" Padding="12,4" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepIndex}" Value="0">
                                        <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="1. Source Selection" FontWeight="SemiBold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepIndex}" Value="0">
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="→" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,6,0" />

                    <!-- Step 2 Indicator -->
                    <Border CornerRadius="14" Padding="12,4" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepIndex}" Value="1">
                                        <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="2. Config Diff (bin/my.ini)" FontWeight="SemiBold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepIndex}" Value="1">
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="→" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,6,0" />

                    <!-- Step 3 Indicator -->
                    <Border CornerRadius="14" Padding="12,4" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepIndex}" Value="2">
                                        <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="3. Preview &amp; Execute" FontWeight="SemiBold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepIndex}" Value="2">
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="→" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,6,0" />

                    <!-- Step 4 Indicator -->
                    <Border CornerRadius="14" Padding="12,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepIndex}" Value="3">
                                        <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="4. Database Table Upgrade" FontWeight="SemiBold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepIndex}" Value="3">
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Active Step Content Area -->
        <Grid Grid.Row="1" Margin="24,18">

            <!-- ========================================== -->
            <!-- STEP 1: SOURCE PACKAGE SELECTION           -->
            <!-- ========================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStepIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,4,0,20">
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="28">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="🐬" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Select MySQL / MariaDB Database Package" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Select an official MySQL or MariaDB distribution archive (.zip or .7z) or provide a download URL." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Active Installed MySQL/MariaDB Build Card -->
                                <Border Background="{StaticResource SurfaceSubtleBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Active Installed Database Engine:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding CurrentInstalledVersion}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0" />
                                                <Border Background="#EEF2F6" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding EngineDisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Quick Download Resources Banner -->
                                <Border Background="{StaticResource SurfaceBgBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🌐 " FontSize="13" VerticalAlignment="Center" />
                                                <TextBlock Text="Download Official MySQL / MariaDB Win64 Binaries:" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="12.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="Official Community / Foundation Windows 64-bit packages"
                                                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="🐬 MySQL Downloads"
                                                    Command="{Binding OpenMySqlDownloadUrlCommand}"
                                                    Visibility="{Binding ShowMySqlDownload, Converter={StaticResource BoolToVisConverter}}"
                                                    Padding="12,7" Margin="0,0,8,0" FontSize="12" />
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="🌐 MariaDB Downloads"
                                                    Command="{Binding OpenMariaDbDownloadUrlCommand}"
                                                    Visibility="{Binding ShowMariaDbDownload, Converter={StaticResource BoolToVisConverter}}"
                                                    Padding="12,7" FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Source Input -->
                                <TextBlock Text="Archive File Path or Download URL:" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding SourcePathOrUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="12,10" FontSize="13" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                            Content="📂 Browse Local File..."
                                            Command="{Binding BrowseLocalFileCommand}"
                                            Margin="10,0,0,0" Padding="14,10" />
                                </Grid>

                                <!-- Safety Notice -->
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                    <TextBlock Text="ℹ️ Safety Notice: The data/ folder containing your live database tables will be preserved and migrated directly into the new installation. Dual zip backups (mysql_backup and mysql_data_backup) will be created automatically."
                                               FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap" />
                                </Border>

                                <!-- Error Display -->
                                <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                                        Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                </Border>

                                <!-- Extraction Status Bar -->
                                <Border Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,20"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,0,8" />
                                        <ProgressBar Height="6"
                                                     IsIndeterminate="{Binding IsIndeterminateProgress}"
                                                     Value="{Binding ProgressPercentage}" Maximum="100" />
                                    </StackPanel>
                                </Border>

                                <!-- Action Buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                                            Content="🛠️ Direct Database Upgrade (Step 4) →"
                                            Command="{Binding ProceedToStep4Command}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                            Padding="14,9" FontSize="12.5" />

                                    <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                                            Content="🔍 Next: Inspect &amp; Compare Configurations →"
                                            Command="{Binding ProcessStep1Command}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                            Padding="20,10" FontSize="13.5" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ========================================== -->
            <!-- STEP 2: CONFIG DIFF & MERGE (bin/my.ini)   -->
            <!-- ========================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStepIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Step 2: Compare MySQL Configuration (bin/my.ini)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Review the differences between your active my.ini configuration and the incoming default template."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Side By Side Diff Viewer Card -->
                <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="0" Margin="0,0,0,12" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <controls:SideBySideDiffViewer Grid.Row="0" DiffItem="{Binding SelectedDiffItem}" />

                        <!-- Empty State if no file selected -->
                        <TextBlock Grid.Row="0" Text="Comparing bin/my.ini configuration..."
                                   FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding SelectedDiffItem, Converter={StaticResource InverseBoolToVisConverter}}" />

                        <!-- Per-File Resolution Selector -->
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10"
                                Visibility="{Binding SelectedDiffItem, Converter={StaticResource BoolToVisConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Resolution for this file:" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            DataContext="{Binding SelectedDiffItem}">
                                    <!-- Keep Current -->
                                    <RadioButton Style="{StaticResource ModernRadioButtonStyle}"
                                                 Content="Keep Current Local (Recommended)"
                                                 IsChecked="{Binding Resolution, Converter={StaticResource ResolutionToBoolConverter}, ConverterParameter=KeepCurrent}"
                                                 FontWeight="SemiBold" FontSize="12" Margin="0,0,16,0" />

                                    <!-- Overwrite with Incoming -->
                                    <RadioButton Style="{StaticResource ModernRadioButtonStyle}"
                                                 Content="Overwrite with Incoming"
                                                 IsChecked="{Binding Resolution, Converter={StaticResource ResolutionToBoolConverter}, ConverterParameter=OverwriteWithNew}"
                                                 FontWeight="SemiBold" FontSize="12" Margin="0,0,16,0" />

                                    <!-- Merged / Custom -->
                                    <RadioButton Style="{StaticResource ModernRadioButtonStyle}"
                                                 Content="Use Merged / Custom"
                                                 IsChecked="{Binding Resolution, Converter={StaticResource ResolutionToBoolConverter}, ConverterParameter=UseMerged}"
                                                 FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Step 2 Navigation Buttons -->
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                            Content="⬅️ Back to Source"
                            Command="{Binding GoBackToStep1Command}"
                            Padding="16,8" FontSize="12.5" />

                    <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                            Content="📋 Next: Review &amp; Execute Pipeline →"
                            Command="{Binding ProceedToStep3Command}"
                            Padding="20,10" FontSize="13.5" />
                </Grid>
            </Grid>

            <!-- ================= STEP 3: CONFIRMATION & EXECUTION ================= -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStepIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Step 3 Checklist Card -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Step 3: Update Execution Pipeline Checklist" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="10,3">
                                <TextBlock Text="{Binding VersionTransitionDisplay}" Foreground="#0369A1" FontSize="11.5" FontWeight="Bold" />
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="✓ 1. Stop Apache &amp; MySQL Windows Services" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                                <TextBlock Text="✓ 2. Automated Dual Zip Backup (mysql_backup &amp; mysql_data_backup)" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                                <TextBlock Text="✓ 3. Rename MySQL folder (mysql_old) &amp; Deploy New Binaries" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="✓ 4. Apply configured my.ini configuration" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                                <TextBlock Text="✓ 5. Migrate live Database data/ folder to new installation" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                                <TextBlock Text="✓ 6. Restart MySQL &amp; Apache Services &amp; Verify Status" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Live Progress & Execution Log Console -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Progress Bar & Status -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                    Content="📋 Copy Logs"
                                    Command="{Binding CopyExecutionLogsCommand}"
                                    Padding="10,3" FontSize="11" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="2" Text="{Binding ProgressPercentage, StringFormat='{}{0:0}%'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <ProgressBar Grid.Row="1" Style="{StaticResource ModernProgressBarStyle}"
                                     Value="{Binding ProgressPercentage}"
                                     IsIndeterminate="{Binding IsIndeterminateProgress}"
                                     Height="10" Margin="0,0,0,12" />

                        <!-- Log Console (Light Theme) -->
                        <Border Grid.Row="2"
                                Background="{StaticResource SurfaceSubtleBgBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="EXECUTION LOG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <ListBox ItemsSource="{Binding ExecutionLogs}"
                                         controls:AutoScrollBehavior.AutoScroll="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                         FontSize="12" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Step 3 Action Buttons Bar -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                            Content="⬅️ Back to Config Diff"
                            Command="{Binding GoBackToStep2Command}"
                            Visibility="{Binding IsExecuting, Converter={StaticResource InverseBoolToVisConverter}}"
                            IsEnabled="{Binding IsCompleted, Converter={StaticResource InverseBoolConverter}}"
                            Padding="16,8" />

                    <!-- Success Message Banner -->
                    <Border Grid.Column="1" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="16,0"
                            Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🧪 Simulation Completed! Ready to update."
                                       FontWeight="Bold" Foreground="#15803D" FontSize="12.5"
                                       Visibility="{Binding IsTestCompleted, Converter={StaticResource BoolToVisConverter}}" />
                            <TextBlock Text="🎉 MySQL Update Succeeded!"
                                       FontWeight="Bold" Foreground="#15803D" FontSize="12.5"
                                       Visibility="{Binding IsTestCompleted, Converter={StaticResource InverseBoolToVisConverter}}" />
                        </StackPanel>
                    </Border>

                    <!-- Error Banner -->
                    <Border Grid.Column="1" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="16,0"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Before Completion -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVisConverter}}">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="🧪 Run Test Mode Simulation"
                                    Command="{Binding RunTestModeSimulationCommand}"
                                    IsEnabled="{Binding IsExecuting, Converter={StaticResource InverseBoolConverter}}"
                                    Padding="16,10" Margin="0,0,10,0" FontSize="13" />

                            <Button Style="{StaticResource SuccessButtonStyle}"
                                    Content="🚀 Execute Real Update Now"
                                    Command="{Binding ExecuteRealUpdateCommand}"
                                    IsEnabled="{Binding IsExecuting, Converter={StaticResource InverseBoolConverter}}"
                                    Padding="20,10" FontSize="13.5" />
                        </StackPanel>

                        <!-- After Test Completed -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsTestCompleted, Converter={StaticResource BoolToVisConverter}}">
                            <CheckBox Content="⚡ Skip backup in real update (already verified)"
                                      IsChecked="{Binding SkipBackupDuringRealUpdate}"
                                      VerticalAlignment="Center"
                                      FontWeight="SemiBold" FontSize="12.5"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,0,14,0" />

                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="🔄 Re-Test Simulation"
                                    Command="{Binding ReTestSimulationCommand}"
                                    Padding="16,10" Margin="0,0,10,0" FontSize="13" />

                            <Button Style="{StaticResource SuccessButtonStyle}"
                                    Content="🚀 Execute Real Update Now"
                                    Command="{Binding ExecuteRealUpdateAfterTestCommand}"
                                    Padding="18,10" Margin="0,0,10,0" FontSize="13" />
                        </StackPanel>

                        <!-- Real Update Completed: Option to Close or Proceed to Step 4 Database Table Upgrade -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsTestCompleted, Converter={StaticResource InverseBoolToVisConverter}}">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="✅ Finish &amp; Close"
                                        Command="{Binding CancelOrCloseCommand}"
                                        Padding="14,10" Margin="0,0,10,0" FontSize="13" />

                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="📋 Next: Upgrade Database Tables (Step 4) →"
                                        Command="{Binding ProceedToStep4Command}"
                                        Padding="18,10" FontSize="13.5" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ========================================== -->
            <!-- STEP 4: DATABASE TABLE UPGRADE             -->
            <!-- ========================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStepIndex}" Value="3">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Configuration & Parameters Card -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Step 4: Upgrade Database Schemas &amp; System Tables (mysql_upgrade)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Run the official mysql_upgrade / mariadb-upgrade tool to check, repair, and upgrade internal system tables for the new database engine."
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Upgrade Script / Tool Path -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Upgrade Script / Tool:" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Grid.Column="1" Text="{Binding MySqlUpgradeToolPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}" FontSize="12.5" Padding="10,6" />
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                                     Content="📂 Browse..."
                                     Command="{Binding BrowseUpgradeToolCommand}"
                                     Padding="14,6" Margin="8,0,0,0" />
                        </Grid>

                        <!-- Service Control & Engine Log Cleanup Bar -->
                        <Border Background="{StaticResource SurfaceSubtleBgBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Service Status & Start/Stop -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="MySQL Service:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Border Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding ServiceStatusDisplay}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" />
                                    </Border>

                                    <Button Style="{StaticResource SuccessButtonStyle}"
                                            Content="▶️ Start Service"
                                            Command="{Binding StartMySqlServiceCommand}"
                                            IsEnabled="{Binding IsOperatingService, Converter={StaticResource InverseBoolConverter}}"
                                            Padding="10,4" FontSize="11.5" Margin="0,0,6,0" />

                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="⏹️ Stop Service"
                                            Command="{Binding StopMySqlServiceCommand}"
                                            IsEnabled="{Binding IsOperatingService, Converter={StaticResource InverseBoolConverter}}"
                                            Padding="10,4" FontSize="11.5" Margin="0,0,10,0" />
                                </StackPanel>

                                <!-- Right: Service & Config Tools -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="📝 Open my.ini"
                                            Command="{Binding OpenMyIniFileCommand}"
                                            ToolTip="Opens my.ini in your default text editor to configure MySQL settings."
                                            Padding="10,5" FontSize="11.5" Margin="0,0,6,0" />

                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="📄 Error Log"
                                            Command="{Binding OpenErrorLogFileCommand}"
                                            ToolTip="Opens MySQL error log (mysql_error.log or hostname.err) in your default text editor."
                                            Padding="10,5" FontSize="11.5" Margin="0,0,6,0" />

                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="↩️ Restore .bak Files"
                                            Command="{Binding RestoreRenamedFilesCommand}"
                                            IsEnabled="{Binding IsOperatingService, Converter={StaticResource InverseBoolConverter}}"
                                            ToolTip="Restores all .bak files in data/ back to their original names."
                                            Padding="10,5" FontSize="11.5" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Parameters Form -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="User:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding MySqlUpgradeUser, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}" FontSize="12" Padding="8,4" />

                            <TextBlock Grid.Column="2" Text="Password:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="14,0,8,0" />
                            <PasswordBox Grid.Column="3" x:Name="UpgradePasswordBox"
                                         PasswordChar="●"
                                         PasswordChanged="UpgradePasswordBox_PasswordChanged"
                                         Style="{StaticResource ModernPasswordBoxStyle}" FontSize="12" Padding="8,4" />

                            <TextBlock Grid.Column="4" Text="Arguments:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="14,0,8,0" />
                            <TextBox Grid.Column="5" Text="{Binding MySqlUpgradeArguments, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}" FontSize="12" Padding="8,4" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Live Execution Console (Light Theme) -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DATABASE UPGRADE OUTPUT LOG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding UpgradeStatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                                    Content="📋 Copy Logs"
                                    Command="{Binding CopyUpgradeLogsCommand}"
                                    Padding="10,3" FontSize="11" />
                        </Grid>

                        <Border Background="{StaticResource SurfaceSubtleBgBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <ListBox ItemsSource="{Binding UpgradeLogs}"
                                     controls:AutoScrollBehavior.AutoScroll="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     FontFamily="Consolas, Cascadia Code, Courier New"
                                     FontSize="12" />
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Step 4 Navigation & Action Footer -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                            Content="⬅️ Back"
                            Command="{Binding GoBackFromStep4Command}"
                            IsEnabled="{Binding IsUpgradingDatabase, Converter={StaticResource InverseBoolConverter}}"
                            Padding="16,8" />

                    <!-- Success Banner -->
                    <Border Grid.Column="1" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="16,0"
                            Visibility="{Binding IsUpgradeSuccess, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="🎉 Database tables upgraded and verified successfully!" FontWeight="Bold" Foreground="#15803D" FontSize="12.5" HorizontalAlignment="Center" />
                    </Border>

                    <!-- Error Banner -->
                    <Border Grid.Column="1" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="16,0"
                            Visibility="{Binding UpgradeErrorMessage, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding UpgradeErrorMessage}" Foreground="#B91C1C" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource WarningButtonStyle}"
                                Content="⚡ Upgrade System Tables Only (-s)"
                                Command="{Binding RunSystemTablesUpgradeOnlyCommand}"
                                IsEnabled="{Binding IsUpgradingDatabase, Converter={StaticResource InverseBoolConverter}}"
                                ToolTip="Skips mysqlcheck phase and directly recreates/upgrades system tables (mysql.gtid_slave_pos, innodb_index_stats, etc.)"
                                Padding="14,10" Margin="0,0,10,0" FontSize="13" />

                        <Button Style="{StaticResource SuccessButtonStyle}"
                                Content="🚀 Run Full Upgrade"
                                Command="{Binding RunMySqlUpgradeCommand}"
                                IsEnabled="{Binding IsUpgradingDatabase, Converter={StaticResource InverseBoolConverter}}"
                                Padding="18,10" Margin="0,0,10,0" FontSize="13.5" />

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="✅ Finish &amp; Close"
                                Command="{Binding CancelOrCloseCommand}"
                                Padding="18,10" FontSize="13.5" />
                    </StackPanel>
                </Grid>
            </Grid>

        </Grid>

        <!-- Bottom Modal Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="XAMPP Local Server Updater • MySQL / MariaDB Upgrade Wizard" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="✕ Cancel &amp; Close" Command="{Binding CancelOrCloseCommand}" Padding="12,6" />
            </Grid>
        </Border>
    </Grid>
</Window>
