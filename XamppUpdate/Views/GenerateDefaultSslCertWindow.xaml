<Window x:Class="XamppUpdate.Views.GenerateDefaultSslCertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:XamppUpdate.ViewModels"
        xmlns:controls="clr-namespace:XamppUpdate.Views.Controls"
        xmlns:conv="clr-namespace:XamppUpdate.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:GenerateDefaultSslCertViewModel}"
        Title="Generate Default SSL Certificate - XAMPP Update"
        Height="780" Width="860"
        MinHeight="650" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBgBrush}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Content ScrollViewer -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="🛡️ Default SSL Certificate Generator" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Renew expired or missing default XAMPP SSL certificates (server.crt / server.key) with a modern 10-year SAN certificate."
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource PrimaryAccentSubtleBrush}" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="Target: conf/ssl.crt/server.crt" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- Main Scrollable Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel Margin="0,0,8,0">

                <!-- 1. Current Default Certificate Status Card -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📄 Current Default XAMPP Certificate" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            
                            <!-- Status Badge -->
                            <Border Grid.Column="1" 
                                    Background="{Binding CurrentCertInfo.StatusBackgroundBrush, FallbackValue={StaticResource SurfaceBgBrush}}" 
                                    CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentCertInfo.StatusBadgeText, FallbackValue='Detecting...'}" 
                                           Foreground="{Binding CurrentCertInfo.StatusForegroundBrush, FallbackValue={StaticResource TextSecondaryBrush}}" 
                                           FontWeight="Bold" FontSize="11.5" />
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Certificate File:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentCertInfo.CertificateFilePath}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Subject (CN):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentCertInfo.CommonName}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Issuer:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentCertInfo.Issuer}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Validity Period:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentCertInfo.ValidityRangeDisplayText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Days Remaining:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentCertInfo.DaysRemainingDisplayText}" FontSize="12" FontWeight="Bold" Foreground="{Binding CurrentCertInfo.StatusForegroundBrush}" Margin="0,2" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Certificate Configuration Inputs -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="⚙️ Certificate Parameters &amp; Subject Details" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Column -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Common Name (CN / Domain):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding CommonName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                                <TextBlock Text="Organization (O):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Organization, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                                <TextBlock Text="Organizational Unit (OU):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding OrganizationalUnit, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                                <TextBlock Text="Subject Alt Names - DNS (comma-separated):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding DnsNames, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            </StackPanel>

                            <!-- Right Column -->
                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Country (C):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="State / Province (ST):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="City / Locality (L):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Locality, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Validity (Days):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ValidityDays, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Key Size (Bits):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding KeySize, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                                <TextBlock Text="Subject Alt Names - IP (comma-separated):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding IpAddresses, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. OpenSSL Configuration & Command Preview -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="📜 Generated cert_config.cnf &amp; OpenSSL Command" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        
                        <Border Background="{StaticResource SurfaceSubtleBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <TextBlock Text="{Binding CommandPreviewText}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        </Border>

                        <Expander Header="View cert_config.cnf preview" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                            <Border Background="{StaticResource SurfaceSubtleBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,0">
                                <TextBlock Text="{Binding ConfigPreviewText}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </Border>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- 4. Live Execution Log (Light Theme) -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📋 Live Execution Log" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                    Content="📋 Copy Logs" Command="{Binding CopyLogsCommand}"
                                    Padding="10,4" FontSize="11.5" />
                        </Grid>

                        <ProgressBar Height="3" IsIndeterminate="{Binding IsGenerating}"
                                     Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisConverter}}"
                                     Foreground="{StaticResource PrimaryAccentBrush}" Background="Transparent"
                                     BorderThickness="0" Margin="0,0,0,6" />

                        <Border Background="{StaticResource SurfaceSubtleBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Height="160">
                            <ListBox ItemsSource="{Binding ExecutionLogs}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11.5"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     controls:AutoScrollBehavior.AutoScroll="True" />
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Close" Command="{Binding CloseCommand}" Margin="0,0,8,0" Padding="16,8" />
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="🚀 Generate &amp; Install SSL Certificate"
                            Command="{Binding GenerateDefaultCertCommand}"
                            IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBoolConverter}}"
                            Padding="18,8" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
