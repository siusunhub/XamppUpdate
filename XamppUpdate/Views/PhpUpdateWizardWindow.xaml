<Window x:Class="XamppUpdate.Views.PhpUpdateWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:XamppUpdate.Views.Controls"
        xmlns:conv="clr-namespace:XamppUpdate.Converters"
        mc:Ignorable="d"
        Title="PHP Engine Update Wizard"
        Height="720" Width="1060"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/app.ico"
        Background="{StaticResource WindowBgBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True" />
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <conv:ResolutionToBooleanConverter x:Key="ResolutionToBoolConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Wizard Step Header Indicator -->
            <RowDefinition Height="Auto" />
            <!-- Active Step Content Area -->
            <RowDefinition Height="*" />
            <!-- Wizard Footer Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Wizard Step Header Indicator -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Title & Version Info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="PHP Update Pipeline" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding CurrentInstalledVersion, StringFormat='Active Installed Version: {0}'}"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Steps Breadcrumb -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Step 1 Indicator -->
                    <Border CornerRadius="14" Padding="12,4" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepIndex}" Value="0">
                                        <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="1. Source Selection" FontWeight="SemiBold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepIndex}" Value="0">
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="→" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,6,0" />

                    <!-- Step 2 Indicator -->
                    <Border CornerRadius="14" Padding="12,4" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepIndex}" Value="1">
                                        <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="2. Config Diff (php.ini)" FontWeight="SemiBold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepIndex}" Value="1">
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="→" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,6,0" />

                    <!-- Step 3 Indicator -->
                    <Border CornerRadius="14" Padding="12,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepIndex}" Value="2">
                                        <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="3. Stop Apache &amp; Execute" FontWeight="SemiBold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStepIndex}" Value="2">
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Active Step Content Area -->
        <Grid Grid.Row="1" Margin="24">

            <!-- ================= STEP 1: SOURCE SELECTION ================= -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStepIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,20">
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="28">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="🐘" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Select PHP Engine Distribution" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Select an official PHP for Windows archive (.zip) or pre-extracted folder." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Active Installed PHP Build Card -->
                                <Border Background="{StaticResource SurfaceSubtleBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Active Installed PHP Build:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding CurrentPhpBuild.Version, StringFormat='PHP {0}'}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0" />
                                                <Border Background="#EEF2F6" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding CurrentPhpBuild.ArchitectureDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Border>
                                                <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding CurrentPhpBuild.ThreadSafetyDisplay}" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Source Path Input -->
                                <TextBlock Text="Package File or Directory Path:" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding SourcePathOrUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}" FontSize="12.5" Padding="10,8" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Browse Zip..."
                                            Command="{Binding BrowseLocalFileCommand}"
                                            Padding="14,8" Margin="8,0,0,0" />
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Browse Folder..."
                                            Command="{Binding BrowseLocalFolderCommand}"
                                            Padding="14,8" Margin="6,0,0,0" />
                                </Grid>

                                <!-- Official PHP Help Banner -->
                                <Border Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Recommended PHP Build for XAMPP (Apache)" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Get the official Thread Safe (TS) x64 PHP releases from php.net."
                                                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                                Content="🌐 Open Download Page"
                                                Command="{Binding OpenPhpOfficialUrlCommand}"
                                                Padding="14,8" VerticalAlignment="Center"
                                                ToolTip="Visit https://www.php.net" />
                                    </Grid>
                                </Border>

                                <!-- Apache Compatibility Warning (if NTS or incompatible) -->
                                <Border Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
                                        Visibility="{Binding IsIncomingCompatibleWithApache, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠️ " FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="WARNING: Selected PHP package is Non-Thread Safe (NTS). Apache on Windows requires Thread Safe (TS) PHP. Apache will fail to start if updated with NTS."
                                                   FontWeight="Bold" Foreground="#B91C1C" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Error Display -->
                                <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                                        Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                </Border>

                                <!-- Fixed-Width Extraction Status Bar (Never resizes the window or parent card) -->
                                <Border Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,20"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,0,8" />
                                        <ProgressBar Height="6"
                                                     IsIndeterminate="{Binding IsIndeterminateProgress}"
                                                     Value="{Binding ProgressPercentage}" Maximum="100" />
                                    </StackPanel>
                                </Border>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="Next: Inspect &amp; Compare Configurations →"
                                            Command="{Binding Step1NextCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                            Padding="20,10" FontSize="13.5" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= STEP 2: CONFIGURATION DIFF (php.ini) ================= -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStepIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Step 2 Top Bar: Configuration File Pulldown Selector -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="📄 Target Config File:" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        </StackPanel>

                        <!-- Pulldown ComboBox -->
                        <ComboBox Grid.Column="1" ItemsSource="{Binding DiffItems}" SelectedItem="{Binding SelectedDiffItem}"
                                  FontSize="12.5" Padding="8,5" VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding RelativeFilePath}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{Binding BadgeBackgroundBrush}"
                                                CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SummaryText}" Foreground="{Binding BadgeForegroundBrush}" FontSize="11" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Summary Status -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="{Binding DiffItems.Count, StringFormat='{}{0} config file(s) analyzed'}"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Side-by-Side Diff Viewer -->
                <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <controls:SideBySideDiffViewer DiffItem="{Binding SelectedDiffItem}" />

                        <!-- Empty State if no file selected -->
                        <TextBlock Text="Select a configuration file from the pulldown menu above to inspect differences."
                                   FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding SelectedDiffItem, Converter={StaticResource InverseBoolToVisConverter}}" />
                    </Grid>
                </Border>

                <!-- Step 2 Bottom Bar: Resolution Options & Navigation -->
                <Border Grid.Row="2" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Back Button -->
                        <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                                Content="← Back to Source"
                                Command="{Binding Step2BackCommand}"
                                Padding="16,8" FontSize="12.5" />

                        <!-- Resolution Options for Currently Selected File -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    DataContext="{Binding SelectedDiffItem}"
                                    Visibility="{Binding SelectedDiffItem, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="Resolution for this file:" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />

                            <!-- Keep Current -->
                            <RadioButton Content="Keep Current Local (Recommended)"
                                         IsChecked="{Binding Resolution, Converter={StaticResource ResolutionToBoolConverter}, ConverterParameter=KeepCurrent}"
                                         FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" />

                            <!-- Overwrite with Incoming -->
                            <RadioButton Content="Overwrite with Incoming"
                                         IsChecked="{Binding Resolution, Converter={StaticResource ResolutionToBoolConverter}, ConverterParameter=OverwriteWithNew}"
                                         FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" />

                            <!-- Merged / Custom -->
                            <RadioButton Content="Use Merged / Custom"
                                         IsChecked="{Binding Resolution, Converter={StaticResource ResolutionToBoolConverter}, ConverterParameter=UseMerged}"
                                         FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Next to Execution -->
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                                Content="Next: Review &amp; Execute Pipeline →"
                                Command="{Binding Step2NextCommand}"
                                Padding="18,8" FontSize="13" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= STEP 3: EXECUTION & LOGS ================= -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStepIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Pipeline Summary Card -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding VersionTransitionDisplay}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Automatic procedure: 1. Full Backup → 2. Stop Apache Service → 3. Update PHP Binaries → 4. Apply php.ini → 5. Start Apache Service"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Right" />
                            <ProgressBar Height="8" Width="220" Margin="0,6,0,0"
                                         IsIndeterminate="{Binding IsIndeterminateProgress}"
                                         Value="{Binding ProgressPercentage}" Maximum="100" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Execution Log Console -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceSubtleBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="EXECUTION LOG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <ListBox ItemsSource="{Binding ExecutionLogs}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontFamily="Consolas, Cascadia Code, Courier New"
                                 FontSize="12" />
                    </DockPanel>
                </Border>

                <!-- Step 3 Action Buttons Bar -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                            Content="← Back to Config Diff"
                            Command="{Binding Step3BackCommand}"
                            Visibility="{Binding IsExecuting, Converter={StaticResource InverseBoolToVisConverter}}"
                            IsEnabled="{Binding IsCompleted, Converter={StaticResource InverseBoolConverter}}"
                            Padding="16,8" />

                    <!-- Success Message Banner -->
                    <Border Grid.Column="1" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="16,0"
                            Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🧪 Test Mode Simulation Completed! Ready to re-test or execute real update."
                                       FontWeight="Bold" Foreground="#15803D" FontSize="12.5"
                                       Visibility="{Binding IsTestCompleted, Converter={StaticResource BoolToVisConverter}}" />
                            <TextBlock Text="🎉 PHP Update Succeeded! Apache service restarted cleanly."
                                       FontWeight="Bold" Foreground="#15803D" FontSize="12.5"
                                       Visibility="{Binding IsTestCompleted, Converter={StaticResource InverseBoolToVisConverter}}" />
                        </StackPanel>
                    </Border>

                    <!-- Error Banner -->
                    <Border Grid.Column="1" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="16,0"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Before Completion: Both Buttons Side-by-Side -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVisConverter}}">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="🧪 Run Test Mode Simulation"
                                    Command="{Binding RunTestModeSimulationCommand}"
                                    IsEnabled="{Binding IsExecuting, Converter={StaticResource InverseBoolConverter}}"
                                    Padding="16,10" Margin="0,0,10,0" FontSize="13" />

                            <Button Style="{StaticResource SuccessButtonStyle}"
                                    Content="🚀 Execute Real Update Now"
                                    Command="{Binding ExecuteRealUpdateCommand}"
                                    IsEnabled="{Binding IsExecuting, Converter={StaticResource InverseBoolConverter}}"
                                    Padding="20,10" FontSize="13.5" />
                        </StackPanel>

                        <!-- After Test Mode Completed: Can Re-test or Real Start Exec -->
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="🔄 Re-Test Simulation"
                                Command="{Binding ReTestSimulationCommand}"
                                Visibility="{Binding IsTestCompleted, Converter={StaticResource BoolToVisConverter}}"
                                Padding="16,10" Margin="0,0,10,0" FontSize="13" />

                        <Button Style="{StaticResource SuccessButtonStyle}"
                                Content="🚀 Execute Real Update Now"
                                Command="{Binding ExecuteRealUpdateAfterTestCommand}"
                                Visibility="{Binding IsTestCompleted, Converter={StaticResource BoolToVisConverter}}"
                                Padding="18,10" Margin="0,0,10,0" FontSize="13" />

                        <!-- Finish / Done Button -->
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Done &amp; Close"
                                Command="{Binding CancelOrCloseCommand}"
                                Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisConverter}}"
                                Padding="20,10" FontSize="13.5" />
                    </StackPanel>
                </Grid>
            </Grid>

        </Grid>

        <!-- Bottom Modal Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="XAMPP Local Server Updater • PHP Engine Guided Wizard" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel &amp; Close" Command="{Binding CancelOrCloseCommand}" Padding="12,6" />
            </Grid>
        </Border>
    </Grid>
</Window>
